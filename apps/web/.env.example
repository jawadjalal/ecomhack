# Admin (optional). Set a key to lock mission control and the state-changing APIs (loop, GitHub PRs,
# simulator, LLM shoppers, raw analytics, the merchant briefing): sign in at /console?key=<token> or send
# "Authorization: Bearer <token>". Without it the gate is open everywhere, public deploys included.
# The team's Grok bot reads GET /api/briefing with this token (see docs/GROK_BOT.md).
DARWIN_ADMIN_TOKEN=
# DARWIN_REQUIRE_ADMIN=1        # lock mission control even without a token (answers 503 until one is set)
# DARWIN_INGEST_RATE=600        # max client events per IP per minute on /api/capture, /ingest, /api/collect

# LLM (optional — without a key the loop uses deterministic heuristics)
# Auto-detect order: xAI → OpenRouter → Anthropic → Apinex (force one with LLM_PROVIDER). All optional.
# The Ask Darwin assistant's tool loop prefers OpenRouter (reliable native tool calling); certificates prefer Grok
# (xAI, else Grok through OpenRouter). A failed or timed-out call is retried ONCE on the fallback (OpenRouter for the
# others, Apinex for OpenRouter), never on the same provider; then callers use their heuristics.
XAI_API_KEY=            # Grok via xAI (sponsor). Optional XAI_MODEL=grok-4
OPENROUTER_API_KEY=     # OpenRouter: default provider, the assistant's tool loop, and the fallback for the others
OPENROUTER_MODEL=deepseek/deepseek-v4-flash   # DeepSeek V4 Flash; any OpenRouter slug with tool calling works
# OPENROUTER_REASONING=off     # skip the model's thinking (faster loop steps)
# READINESS_GROK_MODEL=x-ai/grok-4-fast   # Grok through OpenRouter for certificates when there's no XAI_API_KEY
ANTHROPIC_API_KEY=      # Claude. Optional ANTHROPIC_MODEL=claude-opus-5
APINEX_API_KEY=         # Apinex (OpenAI-compatible, 5 req/min, daily check-in at apinex.bond). Optional APINEX_MODEL=free/gpt-6-luna, APINEX_BASE_URL
# LLM_TIMEOUT_MS=20000         # hard timeout per LLM call; a timeout counts as a failure (fallback once, else heuristics)
# LLM_PROVIDER=xai|openrouter|anthropic|apinex|none
#                         Each LLM call logs one line: "[llm] <provider> <model> answered in <ms>ms" (never the prompt).
#                         Model / provider names stay in server logs and GET /api/llm/health (admin); the UI says "AI" or "rules".

# Research tab (/console/research): market & competitor research via Tavily. Without it you get a labelled sample report.
TAVILY_API_KEY=

# GitHub (optional — without a token PRs run in dry-run mode)
GITHUB_TOKEN=
DARWIN_TARGET_REPO=       # repo for winner PRs if none is connected in the console (e.g. your-org/storefront)
DARWIN_TARGET_CONFIG_PATH=apps/web/storefront.config.json
# DARWIN_GITHUB_DRY_RUN=1                 # read the repo but never write (safe rehearsals)
# DARWIN_PUBLIC_URL=https://darwin-storefront.vercel.app # host baked into the darwin.js install snippet (default: request origin)

# GitHub sign-in for merchants (onboarding: "Sign in with GitHub" → pick a repo → the PR opens as them).
# Create a GitHub OAuth App: callback URL = <your Darwin URL>/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# DARWIN_SESSION_SECRET=      # optional: key for the sealed sign-in cookie (default: DARWIN_ADMIN_TOKEN, then the OAuth client secret)

# Whop (optional — onboarding can also take a pasted key; without either it connects a labelled demo business)
WHOP_API_KEY=           # Developer → API keys on whop.com (same key as `whop login --method api-key`)
# WHOP_COMPANY_ID=biz_2LT2agoxggS3Hr  # storefront catalog defaults to this id; also filters webhooks when set
# WHOP_WEBHOOK_SECRET=  # Developer → Webhooks → Create → Secret (ws_…)
# Webhook URL: https://darwin-storefront.vercel.app/api/whop/webhook  (API v1)
# Events: payment.created, payment.pending, payment.authorized, payment.requires_action,
#   payment.succeeded, payment.failed, payment.canceled, refund.created, refund.updated

# Analytics (posthog-js posts to our own /ingest endpoint; no PostHog account needed)
# NEXT_PUBLIC_POSTHOG_KEY=phc_darwin_local   # project token posthog-js sends (any string works locally)
# NEXT_PUBLIC_DARWIN_POSTHOG=0               # disable posthog-js, fall back to plain /api/capture
# POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com  # where /ingest/static/* redirects

# Telegram (optional — text Darwin). With TELEGRAM_ALLOWED_CHAT_IDS set, those chats can
# run the console assistant's tools (step the loop, experiments, ship). Empty = answer-only.
# Create a bot with @BotFather, then: set these on Vercel, redeploy, and run `npm run telegram:setup`.
# See the Telegram section in the repo README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_WEBHOOK_URL=https://usedarwin.app/api/telegram

# Supabase (optional — default storage is in-memory + .data/ files; set both to mirror events)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EVENTS_TABLE=events               # see supabase/migrations/0001_events.sql
# DARWIN_SUPABASE_MIRROR=0                   # keep the keys but stop mirroring

# Filmed VANTA demo: copy into .env.local (runbook and measured runs: docs/VANTA-DEMO.md).
# LLM_PROVIDER=none keeps the loop on its deterministic heuristics even if LLM keys are set above.
# Volumes don't set the pace: autopilot steps every 2.5s and a round computes in under a second.
# They stay large so human winners are real (ROUND_HUMANS = 4x MIN_ARM_VISITORS: a strong human
# change can decide in round 1). Agent tests run 3x ROUND_AGENTS per round (~150 per arm), under
# MIN_ARM_AGENTS on purpose: round 1 shows the running A/B gauge, round 2 (~300 per arm) decides.
# LLM_PROVIDER=none
# DARWIN_SEED=42
# DARWIN_DEMO_HUMANS=8000
# DARWIN_DEMO_AGENTS=800
# DARWIN_ROUND_HUMANS=10000
# DARWIN_ROUND_AGENTS=100
# DARWIN_MIN_ARM_VISITORS=2500
# DARWIN_MIN_ARM_AGENTS=200
# DARWIN_MAX_ROUNDS=2
# DARWIN_GITHUB_DRY_RUN=1

# Storage
# DARWIN_DATA_DIR=.data
# DARWIN_PERSIST=1
# DARWIN_PERSIST_SYNTHETIC=1   # also write simulated events to .data/events.ndjson (off: they can get huge)
# DARWIN_MAX_EVENTS=250000       # in-memory event cap

# Demo store (lib/demo)
# DARWIN_DEMO_SEED=0           # don't fill the demo store on boot. Default on: a fresh server with no repo / darwin.js
#                              # site runs the loop to Gen 1 with a test live, a restarted one gets one round of
#                              # simulated shoppers (all labelled synthetic). Onboarding's "Skip" button does the same.
# DARWIN_STORE_CATALOG=whop    # also show a "Best of <Whop business>" strip on /store and use its name as the brand.
#                              # Default: /store is PACE end to end (the catalog the loop, simulator and agent tools use).
