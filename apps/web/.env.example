# Admin (optional). Set a key to lock mission control and the state-changing APIs (loop, GitHub PRs,
# simulator, LLM shoppers, raw analytics): sign in at /console?key=<token> or send
# "Authorization: Bearer <token>". Without it the gate is open everywhere, public deploys included.
DARWIN_ADMIN_TOKEN=
# DARWIN_REQUIRE_ADMIN=1        # lock mission control even without a token (answers 503 until one is set)
# DARWIN_INGEST_RATE=600        # max client events per IP per minute on /api/capture, /ingest, /api/collect

# LLM (optional — without a key the loop uses deterministic heuristics)
XAI_API_KEY=            # Grok via xAI (sponsor). Optional XAI_MODEL=grok-4
ANTHROPIC_API_KEY=      # Claude. Optional ANTHROPIC_MODEL=claude-opus-5
OPENROUTER_API_KEY=     # cheap testing via OpenRouter. Optional OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_REASONING=off     # skip the model's thinking: ~5s instead of ~8s per call on DeepSeek V4.1 Flash
# LLM_PROVIDER=xai|anthropic|openrouter|none

# GitHub (optional — without a token PRs run in dry-run mode)
GITHUB_TOKEN=
DARWIN_TARGET_REPO=       # repo for winner PRs if none is connected in the console (e.g. your-org/storefront)
DARWIN_TARGET_CONFIG_PATH=apps/web/storefront.config.json
# DARWIN_GITHUB_DRY_RUN=1                 # read the repo but never write (safe rehearsals)
# DARWIN_PUBLIC_URL=https://darwin-storefront.vercel.app # host baked into the darwin.js install snippet (default: request origin)

# GitHub sign-in for merchants (onboarding: "Sign in with GitHub" → pick a repo → the PR opens as them).
# Create a GitHub OAuth App: callback URL = <your Darwin URL>/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# DARWIN_SESSION_SECRET=      # optional: key for the sealed sign-in cookie (default: DARWIN_ADMIN_TOKEN, then the OAuth client secret)

# Whop (optional — onboarding can also take a pasted key; without either it connects a labelled demo business)
WHOP_API_KEY=           # Developer → API keys on whop.com (same key as `whop login --method api-key`)
# WHOP_COMPANY_ID=biz_2LT2agoxggS3Hr  # storefront catalog defaults to this id; also filters webhooks when set
# WHOP_WEBHOOK_SECRET=  # Developer → Webhooks → Create → Secret (ws_…)
# Webhook URL: https://darwin-storefront.vercel.app/api/whop/webhook  (API v1)
# Events: payment.created, payment.pending, payment.authorized, payment.requires_action,
#   payment.succeeded, payment.failed, payment.canceled, refund.created, refund.updated

# Analytics (posthog-js posts to our own /ingest endpoint; no PostHog account needed)
# NEXT_PUBLIC_POSTHOG_KEY=phc_darwin_local   # project token posthog-js sends (any string works locally)
# NEXT_PUBLIC_DARWIN_POSTHOG=0               # disable posthog-js, fall back to plain /api/capture
# POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com  # where /ingest/static/* redirects

# Supabase (optional — default storage is in-memory + .data/ files; set both to mirror events)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EVENTS_TABLE=events               # see supabase/migrations/0001_events.sql
# DARWIN_SUPABASE_MIRROR=0                   # keep the keys but stop mirroring

# Storage
# DARWIN_DATA_DIR=.data
# DARWIN_PERSIST=1
# DARWIN_PERSIST_SYNTHETIC=1   # also write simulated events to .data/events.ndjson (off: they can get huge)
# DARWIN_MAX_EVENTS=250000       # in-memory event cap
