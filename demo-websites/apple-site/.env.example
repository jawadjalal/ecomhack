# Where Darwin runs. The storefront loads ${NEXT_PUBLIC_DARWIN_URL}/darwin.js.
# Default: http://localhost:3000 (Darwin's `npm run dev`). Live Darwin: https://darwin-production-7899.up.railway.app
# Set to "off" when Darwin's GitHub install PR adds the tag to app/layout.tsx for you.
NEXT_PUBLIC_DARWIN_URL=http://localhost:3000

# The data-darwin-site id. Darwin groups traffic and web personalization rules by it.
NEXT_PUBLIC_DARWIN_SITE=orchard

# Optional: read the PageSpec from another file (default: storefront.config.json).
# STOREFRONT_CONFIG=presets/fixed.json
