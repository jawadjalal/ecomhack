# Where Darwin runs. The site loads `${DARWIN_URL}/darwin.js` (analytics + web personalization).
# Local Darwin: http://localhost:3000   Live Darwin: https://darwin-production-7899.up.railway.app
# Set to "off" to not load the tag (e.g. once Darwin's install PR has added its own tag to app/layout.tsx).
DARWIN_URL=http://localhost:3000

# darwin.js `data-darwin-site`: the site id Darwin groups this store's traffic, rules and heatmaps under.
DARWIN_SITE=rackd
