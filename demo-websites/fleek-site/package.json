{
  "name": "rackd-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Rackd: a demo wholesale-vintage storefront with planted conversion mistakes, driven by a Darwin PageSpec (storefront.config.json).",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "config:gen0": "node scripts/use-config.mjs gen0",
    "config:fixed": "node scripts/use-config.mjs fixed",
    "seed": "node seed/seed.mjs",
    "mirror": "node mirror/mirror.mjs",
    "dev:mirror": "node mirror/server.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.60.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
